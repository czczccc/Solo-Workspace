# --- Login (single user, no registration) ---
AUTH_USERNAME=admin
# Generate with: npm run hash-password -- 'your-strong-password'
# In .env for docker compose, escape each $ as $$ (or use the quoted form below).
AUTH_PASSWORD_HASH='scrypt$16384$8$...'
# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=

# --- Data ---
DATABASE_PATH=./data/solo.db
BACKUP_DIR=./data/backups
# Automatic server-side backups (hours, 0 = off) and how many to keep
AUTO_BACKUP_HOURS=24
BACKUP_KEEP=14

# --- Locale ---
# "Today" and week boundaries use this timezone
TZ=Asia/Shanghai
NEXT_PUBLIC_CURRENCY=CNY

# --- Deployment (docker compose + Caddy) ---
# Public domain pointing at this server; Caddy fetches the HTTPS certificate automatically
DOMAIN=solo.example.com
# Set to false only when testing over plain http
COOKIE_SECURE=true
